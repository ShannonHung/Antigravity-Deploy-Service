# ── Virtual environment ────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Environment files ─────────────────────────────────────────────────────────
.env
.env.dev
.env.local

# ── Build artefacts ───────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── Data files ───────────────────────────────────────────────────────────────
# Real config is machine-specific and/or holds secrets: SSH-*.json carry
# private keys, gitlab_auth.json a GitLab PAT, and the whitelists carry
# per-deployment absolute paths. Track the *.example.json templates instead —
# copy one and drop the .example to activate it. Negations must come last.
data/SSH*.json
data/ssh_keys/
data/allow-commands-*.json
data/gitlab_auth.json
!data/*.example.json

# ── Test-generated SSH key (created on the fly by tests/conftest.py) ────────
tests/fixtures/SSH-default.json

# ── Auto-generated vault-password client (run-ansible.sh; no secret inside) ──
ansible/.ansible_vault

.DS_Store
# ── Superpowers SDD scratch (progress ledger, briefs) ──
.superpowers/

# ── Local TLS certs for fake-api (generated by `make certs`) ──
fake-api/certs/
data/ca.crt
