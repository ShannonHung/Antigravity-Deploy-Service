# ── Virtual environment ────────────────────────────────────────────────────────
.venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Environment files ─────────────────────────────────────────────────────────
.env
.env.dev
.env.local

# ── Build artefacts ───────────────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Test / coverage ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── IDEs ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── Data files ───────────────────────────────────────────────────────────────
data/SSH*.json
data/ssh_keys/
# Real whitelists carry environment-specific absolute paths (and are edited
# per-deployment). Track the *.example.json templates instead; copy one and
# drop the .example to activate it.
data/allow-commands-*.json
!data/allow-commands-*.example.json

# ── Test-generated SSH key (created on the fly by tests/conftest.py) ────────
tests/fixtures/SSH-default.json

# ── Auto-generated vault-password client (run-ansible.sh; no secret inside) ──
ansible/.ansible_vault